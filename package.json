{
  "name": "boondee",
  "version": "0.1.0",
  "private": true,
  "description": "บุญดี Boondee — แอปทำบุญออนไลน์สไตล์พิกเซลอาร์ต",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/mali": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@preact/preset-vite": "^2.10.6",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
